# =============================================================================
# DataFinch / AI Agent Assistance — environment template
# =============================================================================
# Copy to `.env` in this directory (project root):
#   cp .env.example .env
#
# Used by:
#   - docker compose (ai-agent, data-source, datafinch-web overrides)
#   - local CLI (`python cli.py …`) when run from host
#
# NEVER commit `.env` — it may contain API keys.
# =============================================================================

# ── PostgreSQL / ERP simulators (data-source container) ─────────────────────
# Inside Docker Compose these are overridden in docker-compose.yml (DB_HOST=postgres).
# On host (local scripts): use localhost and mapped port 5433.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=postgres

# NiFi HTTP endpoint for payment/shipping webhooks (sim_payment.py)
# Docker default: http://nifi:8181/payment-events
NIFI_ENDPOINT=http://localhost:8181/payment-events

# CSV output for warehouse simulator (shared volume with NiFi in Docker)
CSV_DIR=./csv_output

# ── Data simulator volume control ───────────────────────────────────────────
# Initial bootstrap sizes (one-time, on empty DB).
BOOTSTRAP_CATEGORIES=1000
BOOTSTRAP_PRODUCTS=10000
BOOTSTRAP_CUSTOMERS=20000
BOOTSTRAP_ORDERS=100000

# Hard caps for realtime growth. Sims stop INSERT once cap is hit;
# UPDATE flows (e.g. order status) continue without growing row count.
MAX_PRODUCTS=20000
MAX_CUSTOMERS=50000
MAX_ORDERS=200000
MAX_PAYMENTS=250000

# Batch size for bulk bootstrap inserts
BATCH_SIZE=5000

# ── LLM provider (AI Agent — required for NL→SQL) ───────────────────────────
# Options: anthropic | gemini | openai
LLM_PROVIDER=anthropic

# Token + cache budgets (provider-agnostic)
LLM_MAX_TOKENS_SUPERVISOR=300
LLM_MAX_TOKENS_SQL_WRITER=20000
LLM_CACHE_TTL_SECONDS=300
LLM_CACHE_MAX_ENTRIES=256

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SUPERVISOR=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SQL_WRITER=claude-sonnet-4-6
ANTHROPIC_ADAPTIVE_THINKING=true

# ── Gemini (Google AI Studio) ───────────────────────────────────────────────
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL_SUPERVISOR=gemini-2.5-flash
GEMINI_MODEL_SQL_WRITER=gemini-2.5-flash

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: Azure OpenAI / proxy gateway (default: https://api.openai.com/v1)
OPENAI_BASE_URL=
OPENAI_MODEL_SUPERVISOR=gpt-5-mini
OPENAI_MODEL_SQL_WRITER=gpt-5-mini
# GPT-5*/o-series: minimal | low | medium | high
OPENAI_REASONING_EFFORT=minimal

# ── Hive Gold warehouse (primary analytics backend) ─────────────────────────
# Docker Compose overrides: HIVE_HOST=hiveserver2
# Local dev outside Docker:
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_DB=gold
HIVE_AUTH=NONE
HIVE_QUERY_TIMEOUT_SEC=60
HIVE_MAX_ROWS=1000

# ── Postgres Bronze (operational ERP — optional second backend) ─────────────
# Docker: postgresql://postgres:postgres@postgres:5432/ecommerce
# Host:    postgresql://postgres:postgres@localhost:5433/ecommerce
POSTGRES_URL=postgresql://postgres:postgres@localhost:5433/ecommerce
ENABLE_POSTGRES_BACKEND=true

# ── OpenSearch (semantic layer + query log) ─────────────────────────────────
# Docker: http://opensearch:9200
OPENSEARCH_URL=http://localhost:9200
# OPENSEARCH_USER=
# OPENSEARCH_PASSWORD=

# ── Retrieval tuning ─────────────────────────────────────────────────────────
RETRIEVAL_TOP_K_CATALOG=8
RETRIEVAL_TOP_K_DOCS=3
RETRIEVAL_TOP_K_HISTORY=3
RETRIEVAL_MIN_SCORE=0.3

# ── AI Agent server (local run outside Docker) ───────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── DataFinch Web (Next.js — optional host-side overrides) ──────────────────
# In Docker these defaults are set in docker-compose.yml.
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
