# DataFinch — environment variables
# Copy to .env and fill in real values

# ── LLM Provider ────────────────────────────────────────
# Pick which provider the Generative AI Gateway routes to.
# Options: "anthropic" | "gemini"
LLM_PROVIDER=gemini

# Token + cache budgets (provider-agnostic)
LLM_MAX_TOKENS_SUPERVISOR=300
LLM_MAX_TOKENS_SQL_WRITER=20000
LLM_CACHE_TTL_SECONDS=300
LLM_CACHE_MAX_ENTRIES=256

# ── Anthropic (Claude) ──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL_SUPERVISOR=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SQL_WRITER=claude-sonnet-4-6

# ── Gemini (Google AI Studio) ───────────────────────────
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL_SUPERVISOR=gemini-2.5-flash
GEMINI_MODEL_SQL_WRITER=gemini-2.5-flash

# ── Hive Gold warehouse (primary backend) ───────────────
# Inside docker-compose: HIVE_HOST=hiveserver2
# Outside (local dev):    HIVE_HOST=localhost
HIVE_HOST=localhost
HIVE_PORT=10000
HIVE_DB=gold
HIVE_AUTH=NONE
HIVE_QUERY_TIMEOUT_SEC=60
HIVE_MAX_ROWS=1000

# ── Postgres Bronze (operational ERP) ───────────────────
# Inside docker-compose: postgresql://postgres:postgres@postgres:5432/ecommerce
# Outside (local dev):    postgresql://postgres:postgres@localhost:5433/ecommerce
POSTGRES_URL=postgresql://postgres:postgres@localhost:5433/ecommerce
ENABLE_POSTGRES_BACKEND=true

# ── OpenSearch (semantic layer) ─────────────────────────
# Inside docker-compose: http://opensearch:9200
OPENSEARCH_URL=http://localhost:9200
# OPENSEARCH_USER=
# OPENSEARCH_PASSWORD=

# ── Retrieval tuning ────────────────────────────────────
RETRIEVAL_TOP_K_CATALOG=8
RETRIEVAL_TOP_K_DOCS=3
RETRIEVAL_TOP_K_HISTORY=3
RETRIEVAL_MIN_SCORE=0.3

# ── Server ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
